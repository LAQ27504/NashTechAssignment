@model NashTechRookie.Models.Person

@{
    ViewData["Title"] = "Oldest Person";
}

<h1>Oldest Person</h1>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Full Name</th>
            <th>Gender</th>
            <th>Date of Birth</th>
            <th>Phone Number</th>
            <th>Birth Place</th>
            <th>Graduated</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Id</td>
            <td>@Model.FirstName</td>
            <td>@Model.LastName</td>
            <td>@Model.FullName</td>
            <td>@Model.Gender</td>
            <td>@Model.DateOfBirthString</td>
            <td>@Model.PhoneNumber</td>
            <td>@Model.BirthPlace</td>
            <td>@Model.IsGraduatedString</td>
        </tr>
    </tbody>
</table>