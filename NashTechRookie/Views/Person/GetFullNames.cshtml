@model IEnumerable<string>

@{
    ViewData["Title"] = "Full Names";
}

<h1>Male Persons</h1>

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fullName in Model)
        {
            <tr>
                <td>@fullName</td>
            </tr>
        }
    </tbody>
</table>