@model IEnumerable<NashTechRookie.Models.Person>

@{
    ViewData["Title"] = "Higher 2000";
}

<h1>People Birth Year Higher 2000</h1>


<p>
    <a asp-action="Create" class="btn btn-primary">Create New Person</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Full Name</th>
            <th>Gender</th>
            <th>Date of Birth</th>
            <th>Phone Number</th>
            <th>Birth Place</th>
            <th>Graduated</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in Model)
        {
            <tr>
                <td>@person.Id</td>
                <td>@person.FirstName</td>
                <td>@person.LastName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@person.Id">@person.FullName</a>
                </td>
                <td>@person.Gender</td>
                <td>@person.DateOfBirthString</td>
                <td>@person.PhoneNumber</td>
                <td>@person.BirthPlace</td>
                <td>@person.IsGraduatedString</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@person.Id"
                        asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                        class="btn btn-sm btn-warning">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>